# Copy this file to .env on the Raspberry Pi before launching Cronicle.

# Cronicle UI
TZ=Europe/London
CRONICLE_PORT=3012
CRONICLE_BASE_APP_URL=http://localhost:3012

# Poller secrets. These are passed into the Cronicle container and used by the
# job shell scripts under ops/cronicle/scripts/.
NEXT_PUBLIC_SUPABASE_URL=https://ismxtcfkuwpvfyuojnaa.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Master switch for the Drodo poll jobs. Left unset on purpose: live polling is
# parked (Drodo's public /courier/get no longer returns season MMR), and
# scripts/poll-drodo.mjs exits immediately unless this is exactly "1". Set it
# only when deliberately un-parking the jobs — see "Current status" in README.md.
# DRODO_LIVE_FETCH_ENABLED=1

# Optional: cohort each run walks by default (active | all). The --mode flag
# passed by the Cronicle job takes precedence.
DRODO_POLL_MODE=active

# Optional: Healthchecks.io ping URL for an external dead-man's-switch.
# Use a separate URL per Cronicle job if you want independent alerts.
# HEALTHCHECK_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: max users to process per run.
# - Daily active job defaults to 200 due users from the active cohort, including
#   recent Steam sign-ins and known Queen ladder players.
# - Daily all-player job defaults to 10000 due cached users, oldest fetched
#   first. Due cadence is defined in shared/drodo-core.ts and compiled to shared/drodo-core.mjs.
DRODO_POLL_BATCH_SIZE=200
DRODO_POLL_ALL_BATCH_SIZE=10000

# Optional one-off override for the daily all-player job. Prefer passing
# --season-sweep manually in Cronicle at the start of a new season.
# DRODO_POLL_SEASON_SWEEP=false
