# Copy to .env and fill in. .env is gitignored.
#
# Find your project ID at https://www.sanity.io/manage after creating a project.
SANITY_PROJECT_ID=your_project_id_here
SANITY_DATASET=production

# Studio bundle (Vite) only exposes vars prefixed with SANITY_STUDIO_ to the
# browser. Set these so `sanity build`/`sanity deploy` bake the correct
# projectId/dataset into the deployed Studio JS bundle.
SANITY_STUDIO_PROJECT_ID=your_project_id_here
SANITY_STUDIO_DATASET=production

# Used for migrate / pull / VPK push. Create a Read+Write token at
# https://www.sanity.io/manage/project/<PROJECT>/api#tokens
SANITY_TOKEN=your_write_token_here

# Optional: Studio host name for `sanity deploy` (e.g. dac-cms => dac-cms.sanity.studio).
SANITY_STUDIO_HOSTNAME=dac-cms

# Origin of the Next.js frontend that Presentation iframes for live preview.
# Local dev defaults to http://localhost:3000; deployed Studio should be set to
# the production web URL.
SANITY_STUDIO_PREVIEW_ORIGIN=http://localhost:3000
