NEXT_PUBLIC_SITE_URL=https://your-site.example
STEAM_WEB_API_KEY=your-steam-web-api-key
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Long random string. Vercel cron forwards this as Bearer auth on
# cron-triggered requests to /api/cron/* routes; the poll-drodo handler
# rejects anything else.
CRON_SECRET=

# Comma-separated 64-bit Steam IDs that bypass the manual refresh quota
# and may refresh any profile. Public so the client can decide whether
# to render the refresh button on other people's profiles.
NEXT_PUBLIC_ADMIN_STEAM_IDS=

# Adsterra ad keys (optional). When unset, ad slots render nothing.
# Each key is the publisher key from a single Adsterra ad unit.
# Bottom: 728x90 desktop / 320x50 mobile.
# Sidebar (right): 160x600.
# Sidebar-left: 160x300 (Adsterra disallows duplicate sizes per site).
# In-content: 300x250 medium rectangle, rendered above the fold on
# entity browser pages.
# In-content-2: second 300x250 rendered after the entity grid.
NEXT_PUBLIC_ADSTERRA_KEY_BOTTOM=
NEXT_PUBLIC_ADSTERRA_KEY_SIDEBAR=
NEXT_PUBLIC_ADSTERRA_KEY_SIDEBAR_LEFT=
NEXT_PUBLIC_ADSTERRA_KEY_INCONTENT=
NEXT_PUBLIC_ADSTERRA_KEY_INCONTENT_2=
