NEXT_PUBLIC_SITE_URL=https://your-site.example
STEAM_WEB_API_KEY=your-steam-web-api-key
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Keystatic (optional). In production, set these to enable GitHub-backed edits
# from /keystatic directly against the repo's default branch. Keystatic
# generates the GitHub App client values during its GitHub connection flow.
KEYSTATIC_GITHUB_REPO=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Long random string. Vercel cron forwards this as Bearer auth on
# cron-triggered requests to /api/cron/* routes; the poll-drodo handler
# rejects anything else.
CRON_SECRET=

# Comma-separated 64-bit Steam IDs that bypass the manual refresh quota
# and may refresh any profile. Public so the client can decide whether
# to render the refresh button on other people's profiles.
NEXT_PUBLIC_ADMIN_STEAM_IDS=

# Optional provider guardrails shown on /dashboard/usage. These are plan/budget
# thresholds for visibility only; Vercel billing usage is still checked in the
# Vercel dashboard.
VERCEL_FUNCTION_INVOCATIONS_MONTHLY_LIMIT=
VERCEL_BANDWIDTH_GB_MONTHLY_LIMIT=
VERCEL_EDGE_REQUESTS_MONTHLY_LIMIT=
DRODO_POLL_BATCH_SIZE=200
DRODO_POLL_ALL_BATCH_SIZE=10000

# Product analytics (optional). Vercel Analytics handles anonymous pageviews;
# custom product events are routed to PostHog and are privacy-scoped (raw
# Steam IDs, names, search text, and tokens are stripped). Set to "false" to
# disable trackEvent() calls entirely.
NEXT_PUBLIC_PRODUCT_ANALYTICS=true
NEXT_PUBLIC_ANALYTICS_DEBUG=false

# PostHog (optional). Without the token, all trackEvent() calls no-op. Route
# browser traffic through a neutral first-party proxy subdomain in production;
# avoid analytics/tracking/posthog/ph in the hostname.
# Variable name matches the PostHog setup wizard (npx @posthog/wizard).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# For PostHog managed proxy, set this to the proxy root after the CNAME is live.
NEXT_PUBLIC_POSTHOG_API_HOST=https://t.your-domain.example
# UI host stays on PostHog's real app domain so toolbar links resolve.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# Ads and sponsorships (optional). Set NEXT_PUBLIC_ADS_ENABLED=false to pause
# every ad slot without removing ad keys.
NEXT_PUBLIC_ADS_ENABLED=true

# Optional direct sponsor/job placement. When NEXT_PUBLIC_DIRECT_AD_URL is set,
# matching slots render a first-party sponsored placement instead of network JS.
NEXT_PUBLIC_DIRECT_AD_URL=
NEXT_PUBLIC_DIRECT_AD_TITLE=
NEXT_PUBLIC_DIRECT_AD_DESCRIPTION=
NEXT_PUBLIC_DIRECT_AD_CTA=
NEXT_PUBLIC_DIRECT_AD_SLOTS=bottom,in-content

# Adsterra ad keys (optional). When unset, ad slots render nothing.
# Each key is the publisher key from a single Adsterra ad unit.
# Bottom: 728x90 desktop / 320x50 mobile.
# Sidebar (right): 160x600.
# Sidebar-left: 160x300 (Adsterra disallows duplicate sizes per site).
# In-content: 300x250 medium rectangle, rendered above the fold on
# entity browser pages.
# In-content-2: second 300x250 rendered after the entity grid.
NEXT_PUBLIC_ADSTERRA_KEY_BOTTOM=
NEXT_PUBLIC_ADSTERRA_KEY_SIDEBAR=
NEXT_PUBLIC_ADSTERRA_KEY_SIDEBAR_LEFT=
NEXT_PUBLIC_ADSTERRA_KEY_INCONTENT=
NEXT_PUBLIC_ADSTERRA_KEY_INCONTENT_2=
