# Supabase (required). Without these the web app cannot reach the database:
# every player, match, and leaderboard query fails.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key
# Server-only; never expose to the browser. Required by /api/cron/poll-drodo,
# the standalone poller, and pnpm run embed-content.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public URL, used for metadata and absolute links.
NEXT_PUBLIC_SITE_URL=https://your-site.example
# Host the Twitch chat bot responses link back to. Defaults to
# https://www.trackautochess.com when unset.
NEXT_PUBLIC_SITE_HOST=

STEAM_WEB_API_KEY=your-steam-web-api-key
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Keystatic (optional). In production, set these to enable GitHub-backed edits
# from /keystatic directly against the repo's default branch. Keystatic
# generates the GitHub App client values during its GitHub connection flow.
KEYSTATIC_GITHUB_REPO=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Long random string. Vercel cron forwards this as Bearer auth on
# cron-triggered requests to /api/cron/* routes; the poll-drodo handler
# rejects anything else.
CRON_SECRET=

# Drodo polling. Which cohort the standalone poller walks by default
# (active | all); the --mode flag takes precedence.
DRODO_POLL_MODE=active

# Drodo polling batch sizes used by the poll-drodo cron.
DRODO_POLL_BATCH_SIZE=200
DRODO_POLL_ALL_BATCH_SIZE=10000

# Optional. Healthchecks.io-style dead-man's-switch pinged by the standalone
# poller at start/success/failure.
HEALTHCHECK_URL=
# Optional. Revalidate endpoint the poller pings so /queens rebuilds without
# waiting out its ISR window. Defaults to the production endpoint.
QUEENS_REVALIDATE_URL=

# Product analytics (optional). Vercel Analytics handles anonymous pageviews;
# custom product events are routed to PostHog and are privacy-scoped (raw
# Steam IDs, names, search text, and tokens are stripped). Set to "false" to
# disable trackEvent() calls entirely.
NEXT_PUBLIC_PRODUCT_ANALYTICS=true
NEXT_PUBLIC_ANALYTICS_DEBUG=false

# PostHog (optional). Without the token, all trackEvent() calls no-op. Route
# browser traffic through a neutral first-party proxy subdomain in production;
# avoid analytics/tracking/posthog/ph in the hostname.
# Variable name matches the PostHog setup wizard (npx @posthog/wizard).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# For PostHog managed proxy, set this to the proxy root after the CNAME is live.
NEXT_PUBLIC_POSTHOG_API_HOST=https://t.your-domain.example
# UI host stays on PostHog's real app domain so toolbar links resolve.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
# Optional server-side overrides. Server events prefer these over the
# NEXT_PUBLIC_ values above, so the browser bundle never has to carry them.
POSTHOG_PROJECT_TOKEN=
POSTHOG_API_HOST=

# Vercel AI Gateway (required for chatbot embedding + generation).
# Create in the Vercel dashboard; used by /api/chat and pnpm run embed-content.
AI_GATEWAY_API_KEY=
