{
  "name": "track-auto-chess",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "npm run build:desktop",
    "build:desktop": "pnpm --dir app run build",
    "build:desktop:backend": "pnpm --dir app run build:backend",
    "build:desktop:installer": "node scripts/run-electron-builder.mjs --win --publish never",
    "build:desktop:installer:linux": "node scripts/run-electron-builder.mjs --linux AppImage",
    "build:desktop:installer:dir": "node scripts/run-electron-builder.mjs --dir",
    "build:desktop:all": "pnpm --dir app run build:all",
    "dev:desktop": "node scripts/run-desktop.mjs dev",
    "start:desktop": "node scripts/run-desktop.mjs start",
    "install:desktop": "npm run install:desktop:app && npm run install:desktop:backend",
    "install:desktop:app": "pnpm install --frozen-lockfile",
    "install:desktop:backend": "node scripts/setup-desktop-backend.mjs",
    "verify:desktop:backend": "node scripts/verify-desktop-backend.mjs",
    "generate:ipc-types": "cargo test --manifest-path app/backend/Cargo.toml export_backend_event_bindings -- --ignored",
    "generate:supabase-types": "node scripts/generate-supabase-types.mjs",
    "generate:types": "npm run generate:ipc-types && npm run generate:supabase-types",
    "build:drodo-core": "node scripts/build-drodo-core.mjs",
    "test:drodo-core": "npm run build:drodo-core && node scripts/smoke-drodo-core.mjs",
    "test:patch-notes": "node --test scripts/lib/patch-note-kind.test.mjs scripts/lib/patch-note-changelog.test.mjs scripts/validate-patch-notes.test.mjs web/lib/patchEntryText.test.mjs scripts/scrape-patch-notes.emit.test.mjs",
    "validate:patch-notes": "node scripts/validate-patch-notes.mjs",
    "patch-notes:local": "python scripts/extract_vscripts.py --save && node scripts/validate-patch-notes.mjs --diff-latest",
    "test:synergies": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/smoke-synergies.mjs",
    "import:legacy-mmr-snapshots": "node scripts/import-legacy-mmr-snapshots.mjs",
    "web:data": "node scripts/generate-web-runtime-data.mjs",
    "cms:dev": "pnpm --dir web run dev",
    "guide:fetch": "node scripts/build-guides/fetch-transcript.mjs",
    "guide:match": "node scripts/build-guides/match-entities.mjs"
  },
  "devDependencies": {
    "supabase": "2.105.0",
    "youtube-transcript": "^1.2.1"
  },
  "license": "MIT"
}
