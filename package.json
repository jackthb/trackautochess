{
  "name": "dac-tools",
  "private": true,
  "scripts": {
    "build": "npm run build:desktop",
    "build:desktop": "pnpm --dir app run build",
    "build:desktop:backend": "pnpm --dir app run build:backend",
    "build:desktop:installer": "node scripts/run-electron-builder.mjs --win",
    "build:desktop:installer:linux": "node scripts/run-electron-builder.mjs --linux AppImage",
    "build:desktop:installer:dir": "node scripts/run-electron-builder.mjs --dir",
    "build:desktop:all": "pnpm --dir app run build:all",
    "dev:desktop": "node scripts/run-desktop.mjs dev",
    "start:desktop": "node scripts/run-desktop.mjs start",
    "install:desktop": "npm run install:desktop:app && npm run install:desktop:backend",
    "install:desktop:app": "pnpm --dir app install --frozen-lockfile",
    "install:desktop:backend": "node scripts/setup-desktop-backend.mjs",
    "verify:desktop:backend": "node scripts/verify-desktop-backend.mjs",
    "cms:install": "pnpm --dir cms install",
    "cms:dev": "pnpm --dir cms run dev",
    "cms:pull": "pnpm --dir cms run pull",
    "cms:migrate": "pnpm --dir cms run migrate",
    "migrate": "pnpm --dir cms run migrate",
    "cms:check": "pnpm --dir cms run check"
  }
}
