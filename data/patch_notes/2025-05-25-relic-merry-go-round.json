  "sections": [
    {
      "heading": "Game Rules",
      "entries": [
        {
          "kind": "change",
          "name": "10 random relics will be settled from all 15 relics for a single match",
          "detail": "Relic Pool: Weaponsmith, Wheel of Wonder, Leafy Essence, Magic Box, Greevil Egg, Gaoler’s Master Key, March of the Beasts, Mango Tree, Chiaroscuro Certainty, Malefic Rapture, Doubloon(New!), Time-Space Replica(New!), Magic Seed(Comeback), Shroud of Concealment(Comeback), Second Chance(Comeback), Stolen Vault(Special Choice!)"
        },
        {
          "kind": "change",
          "name": "A special choice of Stolen Vault is provided instead of Discard in the relic box. A bag of random 10 ~ 20 gold will be dropped as a Stolen Vault",
          "detail": ""
        },
        {
          "kind": "change",
          "name": "a relic can only be settled once, but can be replicated by Time-Space Replica. Stolen Vault can also be replicated",
          "detail": ""
        },
        {
          "kind": "change",
          "name": "Recruiting Probability Table slightly changed as follows",
          "detail": "Probability $1 $2 $3 $4 $5 1 100 0 0 0 0 2 85 15 0 0 0 3 70 25 5 0 0 4 55 35 10 0 0 5 40 45 40 35 18 2 0 6 30 35 40 35 25 5 0 7 25 35 30 30 35 10 0 8 20 35 30 30 32 14 17 1 9 20 30 25 25 27 22 25 3 10 15 25 25 30 29 5 6 10+ 15 20 20 37 36 8 9"
        },
        {
          "kind": "change",
          "name": "Dismiss",
          "detail": "Price counts only pieces in chess pool, Pandaren, Undead and unrevealed Legendary pieces not included."
        }
      ]
    },
    {
      "heading": "Relics",
      "entries": [
        {
          "kind": "change",
          "name": "Doubloon",
          "detail": "New coming! <Relic Consumable: Click to Use> Transfer 20% of the higher one of your Health and Mana into another. Can be used twice.",
          "entity_type": "relic",
          "entity_slug": "doubloon"
        },
        {
          "kind": "change",
          "name": "Time-Space Replica",
          "detail": "New coming! Replicate your last relic. P.S. A random relic will be settled if it is your first relic, and this randomed one will not be counted as used (still available later). P.S. Time-Space Replica is not in the relic random pool when you random a relic.",
          "entity_type": "relic",
          "entity_slug": "time-space-replica"
        },
        {
          "kind": "change",
          "name": "Stolen Vault",
          "detail": "New coming! A special choice of Stolen Vault is provided instead of Discard in the relic box. A bag of random 10 ~ 20 gold will be dropped as a Stolen Vault. If you are not interested in any of the 3 relics in the relic box, just get this Vault! P.S. Can be replicated by Time-Space Replica.",
          "entity_type": "relic",
          "entity_slug": "stolen-vault"
        },
        {
          "kind": "change",
          "name": "Magic Seed, Shroud of Concealment, Second Chance",
          "detail": "returned."
        }
      ]
    },
