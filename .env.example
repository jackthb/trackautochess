# Environment for the root-level scripts under scripts/. The web app has its
# own file at web/.env.example; the Cronicle poller has ops/cronicle/.env.example.
#
# This is a reference file, not a template to copy here: nothing reads a
# .env.local at the repository root, and .gitignore's `*.env.local` rule means
# one created here is silently ignored rather than erroring. The two halves
# below are loaded differently — see each section.

# npm run generate:supabase-types
# Read from the process environment only; generate-supabase-types.mjs loads no
# env file. Export these in your shell (or prefix the command) rather than
# writing them to a file.
#
# Supabase project ref to generate types from. When unset, the script falls
# back to the linked project in supabase/.temp/project-ref, and generates
# against the local stack if there is no linked project either.
SUPABASE_PROJECT_ID=
# Comma-separated schemas to include. Defaults to "public".
SUPABASE_SCHEMAS=public

# npm run import:legacy-mmr-snapshots
# Read from the process environment, falling back to web/.env.local — not to a
# root .env.local. Put these in web/.env.local (scripts/backfill-match-player-
# synergies.mjs reads the same file).
#
# Target database the snapshots are written to. The source database is passed
# separately via --from-env-file or --from-url/--from-key.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
