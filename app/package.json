{
  "name": "@dac/desktop",
  "version": "0.1.7",
  "author": "Track Auto Chess",
  "description": "Track Auto Chess desktop app",
  "main": "main.js",
  "scripts": {
    "start": "vite build && electron .",
    "dev:vite": "vite",
    "dev:electron": "electron . --dev",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "build:backend": "node scripts/build-rust-backend.mjs",
    "build:app": "vite build && electron-builder --win dir --config electron-builder.json",
    "build:installer": "vite build && electron-builder --win --config electron-builder.json",
    "build:all": "pnpm run build:backend && pnpm run build:installer"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^33.0.0",
    "electron-builder": "^26.8.1",
    "posthog-js": "^1.373.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
