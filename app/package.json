{
  "name": "dac-tracker",
  "version": "0.1.2",
  "description": "Dota Auto Chess game tracker",
  "main": "main.js",
  "scripts": {
    "start": "vite build && electron .",
    "dev:vite": "vite",
    "dev:electron": "electron . --dev",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "build:backend": "node scripts/build-rust-backend.mjs",
    "build:installer": "vite build && electron-builder --win --config electron-builder.json",
    "build:all": "pnpm run build:backend && pnpm run build:installer"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "devDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.0.0-rc.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^33.0.0",
    "electron-builder": "^26.8.1",
    "lightningcss-linux-x64-gnu": "1.32.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "posthog-js": "^1.373.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
