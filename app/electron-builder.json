{
  "appId": "com.dac-tracker.app",
  "productName": "DAC Tracker",
  "directories": {
    "output": "release"
  },
  "files": [
    "main.js",
    "desktop-paths.cjs",
    "preload.js",
    "preload-overlay.js",
    "preload-notification.js",
    "overlay.html",
    "notification.html",
    "dist/**/*",
    "!node_modules/**/*"
  ],
  "extraResources": [
    {
      "from": "backend-rs/dist/headless",
      "to": "headless",
      "filter": ["**/*"]
    },
    {
      "from": "../data/icons",
      "to": "data/icons",
      "filter": ["**/*"]
    },
    {
      "from": "../content",
      "to": "content",
      "filter": ["**/*"]
    },
    {
      "from": "../data/regions_config.json",
      "to": "data/regions_config.json"
    },
    {
      "from": "../data/screenshots",
      "to": "data/screenshots",
      "filter": ["**/*"]
    },
    {
      "from": "../data/sentinel_ref_final_ranking.png",
      "to": "data/sentinel_ref_final_ranking.png"
    },
    {
      "from": "../data/sentinel_ref_round_start.png",
      "to": "data/sentinel_ref_round_start.png"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "../data/icons/dac_tracker.ico",
    "signtoolOptions": {
      "sign": "./scripts/custom-sign.cjs"
    }
  },
  "linux": {
    "category": "Utility",
    "icon": "../data/icons/dac_tracker.png"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "allowToChangeInstallationDirectory": false,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "installerIcon": "../data/icons/dac_tracker.ico",
    "uninstallerIcon": "../data/icons/dac_tracker.ico"
  },
  "publish": {
    "provider": "github",
    "owner": "jackthb",
    "repo": "dac-tools"
  }
}
