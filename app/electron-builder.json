{
  "appId": "com.trackautochess.app",
  "productName": "Track Auto Chess",
  "directories": {
    "output": "release"
  },
  "files": [
    "main.js",
    "main/**/*",
    "ipc-channels.cjs",
    "desktop-paths.cjs",
    "preload.js",
    "dist/**/*"
  ],
  "asarUnpack": [
    "main/*.ps1"
  ],
  "extraResources": [
    {
      "from": "backend/dist/headless",
      "to": "headless",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "../data/icons",
      "to": "data/icons",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "../content",
      "to": "content",
      "filter": [
        "**/*"
      ]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "../data/icons/track_auto_chess.ico",
    "signtoolOptions": {
      "sign": "./scripts/custom-sign.cjs"
    }
  },
  "linux": {
    "category": "Utility",
    "icon": "../data/icons/track_auto_chess.png"
  },
  "nsis": {
    "artifactName": "Track-Auto-Chess-Setup-${version}.${ext}",
    "oneClick": true,
    "perMachine": false,
    "allowToChangeInstallationDirectory": false,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "installerIcon": "../data/icons/track_auto_chess.ico",
    "uninstallerIcon": "../data/icons/track_auto_chess.ico"
  },
  "publish": {
    "provider": "github",
    "owner": "jackthb",
    "repo": "dac-tools"
  }
}
