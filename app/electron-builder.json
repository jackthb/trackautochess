{
  "appId": "com.dac-tracker.app",
  "productName": "DAC Tracker",
  "directories": {
    "output": "release"
  },
  "files": [
    "main.js",
    "preload.js",
    "preload-overlay.js",
    "preload-widget.js",
    "overlay.html",
    "widget.html",
    "dist/**/*",
    "!node_modules/**/*"
  ],
  "extraResources": [
    {
      "from": "backend/dist/headless",
      "to": "headless",
      "filter": ["**/*"]
    },
    {
      "from": "../data/icons",
      "to": "data/icons",
      "filter": ["**/*"]
    },
    {
      "from": "../data/units.json",
      "to": "data/units.json"
    },
    {
      "from": "../data/units_full.json",
      "to": "data/units_full.json"
    },
    {
      "from": "../data/synergies.json",
      "to": "data/synergies.json"
    },
    {
      "from": "../data/relics.json",
      "to": "data/relics.json"
    },
    {
      "from": "../data/items.json",
      "to": "data/items.json"
    },
    {
      "from": "../data/sentinel_ref_final_ranking.png",
      "to": "data/sentinel_ref_final_ranking.png"
    },
    {
      "from": "../data/sentinel_ref_round_start.png",
      "to": "data/sentinel_ref_round_start.png"
    }
  ],
  "win": {
    "target": [
      {
        "target": "dir",
        "arch": ["x64"]
      }
    ],
    "icon": "../data/icons/dac_tracker.ico"
  },
  "publish": {
    "provider": "github",
    "owner": "jackthb",
    "repo": "dac-tools"
  }
}
